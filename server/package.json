{
    "name": "@eureka/server",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "nodemon --watch . --ext ts,json --exec \"tsx index.ts\"",
        "build": "dotenv -e ../.env -- pnpm prisma generate && tsc",
        "start": "node dist/index.js",
        "prisma:generate": "dotenv -e ../.env -- pnpm prisma generate",
        "test": "vitest run"
    },
    "dependencies": {
        "@google/genai": "^1.34.0",
        "@prisma/client": "5.22.0",
        "@tensorflow/tfjs-node": "^4.22.0",
        "better-auth": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "ml-regression": "^6.3.0",
        "morgan": "^1.10.1",
        "node-cache": "^5.1.2",
        "picocolors": "^1.1.1",
        "prisma": "5.22.0",
        "resend": "^6.6.0",
        "uuid": "^13.0.0",
        "winston": "^3.19.0",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-rate-limit": "^6.0.2",
        "@types/morgan": "^1.9.10",
        "@types/node": "^22.14.0",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.0.0",
        "nodemon": "^3.1.11",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vitest": "^4.0.16"
    }
}