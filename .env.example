# Google Gemini API Key
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (NeonDB)
# Recommended for most uses (with connection pooling)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# PostgreSQL Connection Details (optional, for reference)
PGHOST=your_neon_host
PGDATABASE=your_database_name
PGUSER=your_database_user
PGPASSWORD=your_database_password
POSTGRES_URL=postgresql://user:password@host/database?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@host/database?sslmode=require
POSTGRES_USER=your_database_user
POSTGRES_HOST=your_neon_host
POSTGRES_PASSWORD=your_database_password
POSTGRES_DATABASE=your_database_name

# Stack Auth (if using Next.js auth)
NEXT_PUBLIC_STACK_PROJECT_ID=your_project_id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your_client_key
STACK_SECRET_SERVER_KEY=your_server_key
