{
  "name": "eureka-ai-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"FE,BE\" -c \"cyan,magenta\" \"pnpm --filter @eureka/client dev\" \"pnpm --filter @eureka/server dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "jws": ">=4.0.1"
    },
    "ignoredBuiltDependencies": [
      "@prisma/client",
      "@tensorflow/tfjs-node",
      "core-js",
      "msw"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}