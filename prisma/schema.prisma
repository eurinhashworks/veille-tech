generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String          @id @default(cuid())
  username      String          @unique
  email         String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  favorites     Favorite[]
  reviews       Review[]
  searchHistory SearchHistory[]
  settings      UserSettings?

  @@map("users")
}

model Review {
  id               String        @id @default(cuid())
  date             String        @unique
  formattedDate    String
  content          String
  flashSummary     String
  aiAnalysis       String
  dominantCategory String
  newsCount        Int
  generationTime   Float
  isPublic         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  userId           String
  ReviewToTag      ReviewToTag[]
  favorites        Favorite[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources          Source[]

  @@index([userId])
  @@index([date])
  @@index([dominantCategory])
  @@index([isPublic])
  @@map("reviews")
}

model Tag {
  id          String        @id @default(cuid())
  name        String        @unique
  ReviewToTag ReviewToTag[]

  @@map("tags")
}

model Source {
  id       String @id @default(cuid())
  title    String
  uri      String
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("sources")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([userId])
  @@index([reviewId])
  @@map("favorites")
}

model SearchHistory {
  id        String   @id @default(cuid())
  query     String
  filters   Json?
  results   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("search_history")
}

model UserSettings {
  id                String   @id @default(cuid())
  theme             String   @default("dark")
  defaultVisibility String   @default("public")
  notifications     Boolean  @default(false)
  autoGenerate      Boolean  @default(false)
  aiPreferences     Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model VisitorStats {
  id        String   @id @default(cuid())
  date      DateTime @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visitor_stats")
}

model CurrentVisitors {
  id        String   @id @default(cuid())
  count     Int      @default(0)
  lastReset DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("current_visitors")
}

model ReviewToTag {
  A       String
  B       String
  reviews Review @relation(fields: [A], references: [id], onDelete: Cascade)
  tags    Tag    @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ReviewToTag_AB_pkey")
  @@index([B], map: "_ReviewToTag_B_index")
  @@map("_ReviewToTag")
}
