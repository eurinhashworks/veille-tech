// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modèle User - Utilisateurs de l'application
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reviews       Review[]
  favorites     Favorite[]
  searchHistory SearchHistory[]
  settings      UserSettings?

  @@map("users")
}

// Modèle Review - Revues tech générées
model Review {
  id                String   @id @default(cuid())
  date              String   @unique // Format: YYYY-MM-DD
  formattedDate     String
  content           String   @db.Text
  flashSummary      String   @db.Text
  aiAnalysis        String   @db.Text
  dominantCategory  String
  newsCount         Int
  generationTime    Float
  isPublic          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags      Tag[]
  sources   Source[]
  favorites Favorite[]

  @@index([userId])
  @@index([date])
  @@index([dominantCategory])
  @@index([isPublic])
  @@map("reviews")
}

// Modèle Tag - Tags associés aux revues
model Tag {
  id   String @id @default(cuid())
  name String @unique

  // Relations
  reviews Review[]

  @@map("tags")
}

// Modèle Source - Sources des actualités
model Source {
  id    String @id @default(cuid())
  title String
  uri   String @db.Text

  // Relations
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("sources")
}

// Modèle Favorite - Revues favorites des utilisateurs
model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([userId])
  @@index([reviewId])
  @@map("favorites")
}

// Modèle SearchHistory - Historique des recherches
model SearchHistory {
  id        String   @id @default(cuid())
  query     String
  filters   Json? // Stocke les filtres appliqués (catégorie, tags, dates)
  results   Int // Nombre de résultats trouvés
  createdAt DateTime @default(now())

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("search_history")
}

// Modèle UserSettings - Paramètres utilisateur
model UserSettings {
  id                 String   @id @default(cuid())
  theme              String   @default("dark") // dark, light, auto
  defaultVisibility  String   @default("public") // public, private
  notifications      Boolean  @default(false)
  autoGenerate       Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
