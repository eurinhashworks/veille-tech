generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String          @id @default(cuid())
  username      String          @unique
  email         String?         @unique
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  favorites     Favorite[]
  reviews       Review[]
  searchHistory SearchHistory[]
  settings      UserSettings?
  comments      Comment[]
  integrations  Integration[]
  notifications Notification[]
  shareLinks    ShareLink[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verifications")
}

model Review {
  id               String        @id @default(cuid())
  date             String        @unique
  formattedDate    String
  content          String
  flashSummary     String
  aiAnalysis       String
  dominantCategory String
  newsCount        Int
  generationTime   Float
  isPublic         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  userId           String
  ReviewToTag      ReviewToTag[]
  favorites        Favorite[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources          Source[]
  comments         Comment[]

  @@index([userId])
  @@index([date])
  @@index([dominantCategory])
  @@index([isPublic])
  @@map("reviews")
}

model Tag {
  id          String        @id @default(cuid())
  name        String        @unique
  ReviewToTag ReviewToTag[]

  @@map("tags")
}

model Source {
  id       String @id @default(cuid())
  title    String
  uri      String
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("sources")
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([userId])
  @@index([reviewId])
  @@map("favorites")
}

model SearchHistory {
  id        String   @id @default(cuid())
  query     String
  filters   Json?
  results   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("search_history")
}

model UserSettings {
  id                String   @id @default(cuid())
  theme             String   @default("dark")
  defaultVisibility String   @default("public")
  notifications     Boolean  @default(false)
  autoGenerate      Boolean  @default(false)
  aiPreferences     Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model VisitorStats {
  id        String   @id @default(cuid())
  date      DateTime @unique
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("visitor_stats")
}

model CurrentVisitors {
  id        String   @id @default(cuid())
  count     Int      @default(0)
  lastReset DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("current_visitors")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  reviewId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([reviewId])
  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  type      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Integration {
  id        String   @id @default(cuid())
  provider  String
  config    Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("integrations")
}

model ShareLink {
  id         String    @id @default(cuid())
  resourceId String
  token      String    @unique
  views      Int       @default(0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("share_links")
}

model ReviewToTag {
  A       String
  B       String
  reviews Review @relation(fields: [A], references: [id], onDelete: Cascade)
  tags    Tag    @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_ReviewToTag_AB_pkey")
  @@index([B], map: "_ReviewToTag_B_index")
  @@map("_ReviewToTag")
}
